# ==========================================================
# 1. System & Common Settings
# ==========================================================
TZ=Asia/Seoul
GATEWAY_PORT=80
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
# 인프라 전용 메모리 제한
GATEWAY_MEM_LIMIT=128m

# ==========================================================
# 2. Database Settings (PostgreSQL & Redis)
# ==========================================================
DB_NAME=adminax
DB_USER=wellconn
DB_PASSWORD=dbdnpfzjs1!

# Message Broker (Redis) 자원 제한
REDIS_MEM_LIMIT=256m

# ==========================================================
# 3. Search Engine (Elasticsearch)
# 8GB 환경 최적화: Heap(1.2G) < Limit(2G) 구조로 안정성 확보
# ==========================================================
ES_HEAP_SIZE=1200m
ES_MEM_LIMIT=2G

# ==========================================================
# 4. Core Engine (Spring Boot - Java 21)
# ==========================================================
JAVA_OPTS=-Xms512m -Xmx1024m
CORE_MEM_LIMIT=1.5G
API_SERVER_PORT=8080
API_SERVER_CONTEXT=/api
WS_MAX_BUFFER_SIZE=20

# ==========================================================
# 5. Converter & AI Worker Settings (Business Logic)
# ==========================================================
# Redis Streams 설정
INPUT_STREAM=adminax:convert:stream
RESULT_STREAM=adminax:result:stream
GROUP_NAME=converter_group
CONSUMER_NAME=worker_1

# 컨버터 자원 제한 (LibreOffice 피크 대비)
CONVERTER_MEM_LIMIT=1G

# [추가] Adapter Layer (MoE 및 모델 중계 로직)
ADAPTER_MEM_LIMIT=1G

# ==========================================================
# 5.1 AI Inference Settings (Ollama / Local LLM)
# ==========================================================
# Ollama 자원 제한 (모델 크기에 따라 가변적)
OLLAMA_MEM_LIMIT=2G

# GPU 가속 제어 (현재 CPU 모드: COUNT=0 / GPU 전환 시: COUNT=1, DRIVER=nvidia)
OLLAMA_GPU_DRIVER=
OLLAMA_GPU_COUNT=0

# ==========================================================
# 6. UI Settings (Admin & Chat)
# ==========================================================
# Admin UI 자원 제한
ADMIN_UI_MEM_LIMIT=512m

# Chat UI Settings
CHAT_UI_BUILD_TARGET=development
NODE_ENV=development
CHAT_UI_MEM_LIMIT=512m

# ==========================================================
# 7. Security & API Keys
# ==========================================================
# HuggingFace 및 로컬 인증 토큰
HF_API_TOKEN=your_token_here
LOCAL_MODEL_SECRET=optional_secret